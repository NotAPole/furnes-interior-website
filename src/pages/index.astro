---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.home {
				display: flex;
				flex-direction: column;
				align-items: center;
				text-align: center;
				padding: 2em 0 4em;
			}
			.home-logo {
				width: min(420px, 85vw);
				height: auto;
				margin-bottom: 2.5rem;
			}
			.home-intro {
				max-width: 36ch;
				margin: 0;
				color: rgb(var(--gray-dark));
				font-size: 1.125em;
				line-height: 1.75;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="home">
				<img
					class="home-logo"
					src="/images/logo.jpg"
					width={747}
					height={1024}
					alt="Furnes Interiør"
				/>
				<p class="home-intro">
					Welcome to Furnes Interiør. I will be sharing product highlights and interior videos
					here soon — check back for new posts as the collection grows.
				</p>
			</section>
		</main>
		<Footer />
	</body>
</html>
